model User {
  id   String   @id @default(uuid()) @db.Uuid
  role UserRole

  name          String  @db.VarChar(255)
  phone         String? @unique @db.VarChar(20)
  email         String? @unique @db.VarChar(255)
  password      String? @db.VarChar(255)
  googleId      String? @unique
  authProvider  AuthProvider @default(CREDENTIAL)

  status        UserStatus   @default(ACTIVE)
  isVerified Boolean @default(false)

  emergencyContactName  String?    @db.VarChar(255)
  emergencyContactPhone String?    @db.VarChar(20)
  bloodType             BloodType?
  knownConditions       String?    @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  driverProfile          Driver?
  emergencyRequests      EmergencyRequest[] @relation("PatientEmergencies")
  prioritizedEmergencies EmergencyRequest[] @relation("PrioritizedBy")
  cancelledEmergencies   EmergencyRequest[] @relation("CancelledBy")
  dispatchesCreated      Dispatch[]         @relation("DispatchedBy")
  trips                  Trip[]             @relation("PatientTrips")
  payments               Payment[]

  @@map("users")
}
