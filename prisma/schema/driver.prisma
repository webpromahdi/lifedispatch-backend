model Driver {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @db.Uuid
  licenseNumber      String             @unique @db.VarChar(100)
  licenseExpiry      DateTime           @db.Date
  certificationLevel CertificationLevel

  shiftStatus ShiftStatus @default(OFF_SHIFT)
  shiftStart  DateTime?
  shiftEnd    DateTime?

  totalTripsCompleted Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User       @relation(fields: [userId], references: [id])
  ambulance           Ambulance? @relation(fields: [assignedAmbulanceId], references: [id])
  assignedAmbulanceId String?    @unique @db.Uuid

  dispatches Dispatch[]
  trips      Trip[]

  @@map("drivers")
}
