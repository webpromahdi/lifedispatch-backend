model Dispatch {
  id           String @id @default(uuid()) @db.Uuid
  emergencyId  String @db.Uuid
  ambulanceId  String @db.Uuid
  driverId     String @db.Uuid
  dispatchedBy String @db.Uuid

  status          DispatchStatus @default(PENDING_ACCEPTANCE)
  dispatchScore   Decimal?       @db.Decimal(8, 4)
  rejectionReason String?        @db.Text

  acceptedAt DateTime?
  rejectedAt DateTime?
  timeoutAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emergency  EmergencyRequest @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  ambulance  Ambulance        @relation(fields: [ambulanceId], references: [id], onDelete: Cascade)
  driver     Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  dispatcher User             @relation("DispatchedBy", fields: [dispatchedBy], references: [id], onDelete: Cascade)
  trip       Trip?

  @@index([emergencyId])
  @@index([ambulanceId])
  @@index([status])
  @@map("dispatches")
}
